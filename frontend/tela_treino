<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar treino | Gym-System</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            background: #221b1b;
            color: #fff;
            font-family: Arial, sans-serif;
        }
        header {
            background: #2b2525;
            border-bottom: 1px solid #444;
            padding: 18px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }
        header h1 { margin: 0; font-size: 21px; }
        .btn-voltar, .btn-principal, .btn-secundario, .btn-remover {
            border: 0;
            border-radius: 6px;
            padding: 10px 15px;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }
        .btn-voltar, .btn-secundario { background: #514646; }
        .btn-principal { background: #28a745; }
        .btn-principal:hover { background: #218838; }
        .btn-voltar:hover, .btn-secundario:hover { background: #665858; }
        main {
            width: min(100% - 32px, 920px);
            margin: 32px auto;
        }
        .painel {
            background: rgba(107, 93, 93, .20);
            border: 1px solid #444;
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 20px;
        }
        .topo-pagina { margin-bottom: 22px; }
        .topo-pagina h2 { margin: 0 0 7px; font-size: 25px; }
        .texto-apoio { color: #bbb; margin: 0; line-height: 1.5; }
        .aluno-atual {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(40, 167, 69, .12);
            border: 1px solid rgba(40, 167, 69, .55);
            border-radius: 7px;
            padding: 13px 15px;
            margin-top: 18px;
        }
        .aluno-atual strong { color: #7ee49a; }
        label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            font-size: 14px;
        }
        input, textarea {
            width: 100%;
            background: rgba(50, 45, 45, .9);
            color: white;
            border: 1px solid #5a5050;
            border-radius: 6px;
            padding: 11px 12px;
            font: inherit;
            outline: none;
        }
        input:focus, textarea:focus { border-color: #28a745; }
        textarea { resize: vertical; min-height: 78px; }
        .campo { margin-bottom: 17px; }
        .titulo-secao {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }
        .titulo-secao h3 { margin: 0; font-size: 19px; }
        .contador { color: #aaa; font-size: 13px; }
        .busca { margin-bottom: 12px; }
        .lista-exercicios {
            border: 1px solid #494141;
            border-radius: 7px;
            overflow: hidden;
            max-height: 280px;
            overflow-y: auto;
        }
        .item-exercicio {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 13px 15px;
            border-bottom: 1px solid #494141;
        }
        .item-exercicio:last-child { border-bottom: 0; }
        .item-exercicio strong { display: block; margin-bottom: 4px; }
        .item-exercicio small { color: #bbb; }
        .btn-adicionar {
            flex-shrink: 0;
            border: 1px solid #28a745;
            background: rgba(40, 167, 69, .12);
            color: #8bea9f;
            border-radius: 5px;
            padding: 7px 11px;
            font-weight: bold;
            cursor: pointer;
        }
        .btn-adicionar:hover { background: #28a745; color: white; }
        .lista-selecionados { display: grid; gap: 12px; }
        .exercicio-selecionado {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 110px 130px 38px;
            align-items: end;
            gap: 10px;
            background: rgba(35, 29, 29, .75);
            border: 1px solid #494141;
            border-radius: 7px;
            padding: 13px;
        }
        .exercicio-selecionado .nome-exercicio {
            align-self: center;
            font-weight: bold;
            padding-bottom: 8px;
        }
        .exercicio-selecionado label { font-size: 12px; color: #ccc; }
        .exercicio-selecionado input { padding: 9px; }
        .btn-remover {
            background: #6b3030;
            padding: 9px 0;
            font-size: 17px;
        }
        .vazio {
            color: #aaa;
            text-align: center;
            padding: 22px 12px;
            border: 1px dashed #5a5050;
            border-radius: 7px;
        }
        .rodape-acoes {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }
        #mensagem {
            display: none;
            padding: 12px 14px;
            border-radius: 6px;
            margin-top: 16px;
            line-height: 1.4;
        }
        #mensagem.erro { display: block; background: rgba(220, 53, 69, .15); border: 1px solid #a83b48; }
        #mensagem.sucesso { display: block; background: rgba(40, 167, 69, .15); border: 1px solid #28a745; }
        @media (max-width: 650px) {
            header { padding: 15px; }
            main { width: min(100% - 20px, 920px); margin: 18px auto; }
            .painel { padding: 17px; }
            .exercicio-selecionado { grid-template-columns: 1fr 1fr 1fr 36px; }
            .exercicio-selecionado .nome-exercicio { grid-column: 1 / -1; padding: 0; }
            .rodape-acoes { flex-direction: column-reverse; }
            .rodape-acoes button { width: 100%; }
        }
    </style>
</head>
<body>
    <header>
        <button class="btn-voltar" type="button" onclick="history.back()">← Voltar</button>
        <h1>Gym-System</h1>
    </header>

    <main>
        <section class="topo-pagina">
            <h2>Criar treino</h2>
            <p class="texto-apoio">Monte um treino selecionando exercícios já cadastrados e definindo séries e repetições.</p>
            <div class="aluno-atual">
                <span>Aluno:</span>
                <strong id="nome-aluno">Carregando...</strong>
            </div>
        </section>

        <section class="painel">
            <div class="campo">
                <label for="nome-treino">Nome do treino</label>
                <input id="nome-treino" type="text" placeholder="Ex.: Treino A — Peito e Tríceps" maxlength="100" required>
            </div>
            <div class="campo" style="margin-bottom:0">
                <label for="descricao-treino">Descrição (opcional)</label>
                <textarea id="descricao-treino" placeholder="Informações ou orientações sobre este treino..."></textarea>
            </div>
        </section>

        <section class="painel">
            <div class="titulo-secao">
                <h3>Exercícios disponíveis</h3>
                <span class="contador" id="contador-disponiveis">Carregando...</span>
            </div>
            <input class="busca" id="pesquisa-exercicios" type="search" placeholder="Pesquisar exercício pelo nome ou máquina...">
            <div class="lista-exercicios" id="lista-exercicios">
                <div class="vazio">Carregando exercícios cadastrados...</div>
            </div>
        </section>

        <section class="painel">
            <div class="titulo-secao">
                <h3>Exercícios do treino</h3>
                <span class="contador" id="contador-selecionados">0 selecionados</span>
            </div>
            <div class="lista-selecionados" id="lista-selecionados">
                <div class="vazio">Adicione exercícios da lista acima para montar o treino.</div>
            </div>
            <div id="mensagem"></div>
            <div class="rodape-acoes">
                <button class="btn-secundario" type="button" onclick="history.back()">Cancelar</button>
                <button class="btn-principal" type="button" id="btn-salvar" onclick="salvarTreino()">Salvar treino</button>
            </div>
        </section>
    </main>

    <script>
        const API = "http://127.0.0.1:5000";
        const parametros = new URLSearchParams(window.location.search);
        const alunoId = Number(parametros.get("aluno_id"));
        const alunoNome = parametros.get("aluno_nome") || "Aluno não identificado";
        let exerciciosDisponiveis = [];
        let exerciciosSelecionados = [];

        document.getElementById("nome-aluno").textContent = alunoNome;

        function escaparHTML(valor) {
            return String(valor ?? "").replace(/[&<>"']/g, caractere => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
            })[caractere]);
        }

        function mostrarMensagem(texto, tipo) {
            const elemento = document.getElementById("mensagem");
            elemento.textContent = texto;
            elemento.className = tipo;
        }

        async function carregarExercicios() {
            const lista = document.getElementById("lista-exercicios");
            try {
                const resposta = await fetch(`${API}/exercicios`);
                const dados = await resposta.json();
                if (!resposta.ok) throw new Error(dados.mensagem || "Não foi possível carregar os exercícios.");
                exerciciosDisponiveis = dados;
                renderizarExercicios();
            } catch (erro) {
                lista.innerHTML = `<div class="vazio">${escaparHTML(erro.message)} Verifique se o Flask está em execução.</div>`;
                document.getElementById("contador-disponiveis").textContent = "Indisponível";
            }
        }

        function renderizarExercicios() {
            const termo = document.getElementById("pesquisa-exercicios").value.trim().toLowerCase();
            const lista = document.getElementById("lista-exercicios");
            const filtrados = exerciciosDisponiveis.filter(ex =>
                `${ex.nome} ${ex.maquina}`.toLowerCase().includes(termo)
            );
            document.getElementById("contador-disponiveis").textContent =
                `${filtrados.length} exercício(s)`;

            if (filtrados.length === 0) {
                lista.innerHTML = '<div class="vazio">Nenhum exercício encontrado.</div>';
                return;
            }

            lista.innerHTML = filtrados.map(ex => {
                const jaAdicionado = exerciciosSelecionados.some(item => item.id_exercicio === ex.id_exercicio);
                return `
                    <div class="item-exercicio">
                        <div>
                            <strong>${escaparHTML(ex.nome)}</strong>
                            <small>${escaparHTML(ex.maquina || "Máquina não informada")}</small>
                        </div>
                        <button class="btn-adicionar" type="button"
                            onclick="adicionarExercicio(${Number(ex.id_exercicio)})"
                            ${jaAdicionado ? "disabled" : ""}>
                            ${jaAdicionado ? "Adicionado" : "+ Adicionar"}
                        </button>
                    </div>
                `;
            }).join("");
        }

        function adicionarExercicio(id) {
            const exercicio = exerciciosDisponiveis.find(ex => Number(ex.id_exercicio) === id);
            if (!exercicio || exerciciosSelecionados.some(item => item.id_exercicio === id)) return;
            exerciciosSelecionados.push({
                id_exercicio: id,
                nome: exercicio.nome,
                series: 3,
                repeticoes: 10
            });
            renderizarExercicios();
            renderizarSelecionados();
        }

        function atualizarCampo(id, campo, valor) {
            const item = exerciciosSelecionados.find(ex => ex.id_exercicio === id);
            if (!item) return;
            item[campo] = Number(valor);
        }

        function removerExercicio(id) {
            exerciciosSelecionados = exerciciosSelecionados.filter(ex => ex.id_exercicio !== id);
            renderizarExercicios();
            renderizarSelecionados();
        }

        function renderizarSelecionados() {
            const lista = document.getElementById("lista-selecionados");
            document.getElementById("contador-selecionados").textContent =
                `${exerciciosSelecionados.length} selecionado(s)`;

            if (exerciciosSelecionados.length === 0) {
                lista.innerHTML = '<div class="vazio">Adicione exercícios da lista acima para montar o treino.</div>';
                return;
            }

            lista.innerHTML = exerciciosSelecionados.map(ex => `
                <div class="exercicio-selecionado">
                    <div class="nome-exercicio">${escaparHTML(ex.nome)}</div>
                    <div>
                        <label for="series-${ex.id_exercicio}">Séries</label>
                        <input id="series-${ex.id_exercicio}" type="number" min="1" max="30"
                            value="${ex.series}" onchange="atualizarCampo(${ex.id_exercicio}, 'series', this.value)">
                    </div>
                    <div>
                        <label for="reps-${ex.id_exercicio}">Repetições</label>
                        <input id="reps-${ex.id_exercicio}" type="number" min="1" max="100"
                            value="${ex.repeticoes}" onchange="atualizarCampo(${ex.id_exercicio}, 'repeticoes', this.value)">
                    </div>
                    <button class="btn-remover" type="button" title="Remover exercício"
                        onclick="removerExercicio(${ex.id_exercicio})">×</button>
                </div>
            `).join("");
        }

        async function salvarTreino() {
            const nome = document.getElementById("nome-treino").value.trim();
            const descricao = document.getElementById("descricao-treino").value.trim();

            if (!alunoId || alunoId <= 0) {
                mostrarMensagem("Não foi possível identificar o aluno. Abra esta tela pelo botão Criar treino dentro do cadastro do aluno.", "erro");
                return;
            }
            if (!nome) {
                mostrarMensagem("Informe um nome para o treino.", "erro");
                return;
            }
            if (exerciciosSelecionados.length === 0) {
                mostrarMensagem("Adicione pelo menos um exercício ao treino.", "erro");
                return;
            }
            if (exerciciosSelecionados.some(ex => !Number.isInteger(ex.series) || ex.series < 1 ||
                !Number.isInteger(ex.repeticoes) || ex.repeticoes < 1)) {
                mostrarMensagem("Confira as séries e repetições dos exercícios.", "erro");
                return;
            }

            const botao = document.getElementById("btn-salvar");
            botao.disabled = true;
            botao.textContent = "Salvando...";

            try {
                const resposta = await fetch(`${API}/treinos`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        id_aluno: alunoId,
                        nome,
                        descricao,
                        exercicios: exerciciosSelecionados.map(ex => ({
                            id_exercicio: ex.id_exercicio,
                            series: ex.series,
                            repeticoes: ex.repeticoes
                        }))
                    })
                });
                const dados = await resposta.json();
                if (!resposta.ok) throw new Error(dados.mensagem || "Erro ao salvar o treino.");
                mostrarMensagem("Treino salvo com sucesso!", "sucesso");
                botao.textContent = "Treino salvo";
            } catch (erro) {
                mostrarMensagem(`${erro.message} Confira se a rota POST /treinos já foi criada no Flask.`, "erro");
                botao.disabled = false;
                botao.textContent = "Salvar treino";
            }
        }

        document.getElementById("pesquisa-exercicios").addEventListener("input", renderizarExercicios);
        carregarExercicios();
    </script>
</body>
</html>
